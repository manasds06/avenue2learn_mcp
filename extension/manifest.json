{
  "manifest_version": 3,
  "name": "Brightspace Assistant",
  "version": "0.1.0",
  "description": "Ask about your university's Brightspace courses — deadlines, grades, announcements, and what's actually in your course files.",
  "permissions": [
    "storage",
    "unlimitedStorage",
    "sidePanel"
  ],
  "host_permissions": [
    "https://generativelanguage.googleapis.com/*"
  ],
  "optional_host_permissions": [
    "https://avenue.cllmcmaster.ca/*",
    "https://avenue.mcmaster.ca/*",
    "https://brightspace.carleton.ca/*",
    "https://westernu.brightspace.com/*"
  ],
  "content_security_policy": {
    "extension_pages": "script-src 'self' 'wasm-unsafe-eval'; object-src 'self'"
  },
  "background": {
    "service_worker": "background/worker.js",
    "type": "module"
  },
  "side_panel": {
    "default_path": "ui/sidepanel.html"
  },
  "action": {
    "default_title": "Brightspace Assistant"
  },
  "minimum_chrome_version": "116"
}
